datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  role      String   @default("CLIENTE") // "CLIENTE" ou "FUNCIONARIO"
  orders    Order[]
  createdAt DateTime @default(now())
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String?
  category    String?
  imageUrl    String?
  isAvailable Boolean       @default(true) // Controle de Disponível / Esgotado
  sizes       ProductSize[]
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ProductSize {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // Ex: "Fatia", "Bolo Inteiro 1.5kg"
  price     Float
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  total             Float
  status            String      @default("PENDING") // PENDING, CONFIRMED, IN_PREPARATION, READY, DELIVERED, CANCELLED
  fulfillmentMethod String      @default("RETIRADA") // "RETIRADA" ou "ENTREGA"
  requestedDate     DateTime    // Data desejada selecionada pelo cliente
  deliveryAddress   String?     // Endereço (obrigatório se fulfillmentMethod === "ENTREGA")
  notes             String?     // Observações adicionais do cliente
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  sizeName  String
  price     Float
  quantity  Int
} 